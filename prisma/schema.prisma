// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Roles {
  Teacher
  Student
}

model Users {
  UserId          String       @id @unique @default(uuid())
  UserName        String
  UserEmail       String
  UserPassword    String
  UserRole        Roles        @default(Student)
  UserSubmissions Submission[]
}

model Task {
  TaskId          String       @id @unique @default(uuid())
  TaskTitle       String
  TaskSubmissions Submission[]
}

model Submission {
  SubId   String  @id @unique @default(uuid())
  SubGrad Float?
  SubFile Bytes

  StudentSubmission   Users  @relation(fields: StudentSubmissionId, references: UserId)
  StudentSubmissionId String
  TaskSubmission      Task   @relation(fields: TaskSubmissionId, references: TaskId)
  TaskSubmissionId String
}
